  "reports": [
    {
      "reportId": "aps-job-board",
      "title": "APS Job Board",
      "description": "Active job orders from erp-mes-core (cross-schema).",
      "query": "\nSELECT o.job_no, o.dispatch_status, COALESCE(o.equipment_id,'') AS equipment_id,\n       COALESCE(o.priority, 0) AS priority, o.planned_start, o.planned_end,\n       COALESCE(wr.quantity, 0) AS quantity, COALESCE(wr.uom,'') AS uom\nFROM app_erp_mes_core.emc_job_order o\nJOIN app_erp_mes_core.emc_work_request wr ON wr.request_id = o.request_id\nWHERE o.dispatch_status NOT IN ('ENDED', 'ABORTED', 'CANCELLED')\nORDER BY o.priority, o.planned_start\n",
      "columns": [
        {
          "field": "job_no",
          "label": "Job #"
        },
        {
          "field": "dispatch_status",
          "label": "Status"
        },
        {
          "field": "equipment_id",
          "label": "Equipment"
        },
        {
          "field": "priority",
          "label": "Pri"
        },
        {
          "field": "planned_start",
          "label": "Start"
        },
        {
          "field": "planned_end",
          "label": "End"
        },
        {
          "field": "quantity",
          "label": "Qty"
        },
        {
          "field": "uom",
          "label": "UOM"
        }
      ]
    },
    {
      "reportId": "aps-conflicts",
      "title": "APS Conflicts",
      "description": "Resource busy + missing capability window.",
      "query": "\nSELECT o.job_no, COALESCE(o.equipment_id,'') AS equipment_id, o.dispatch_status,\n       'RESOURCE_BUSY' AS conflict_kind,\n       CONCAT('Another RUNNING job on ', o.equipment_id) AS detail\nFROM app_erp_mes_core.emc_job_order o\nWHERE o.dispatch_status IN ('ALLOWED','NOT_ALLOWED')\nAND EXISTS (\n  SELECT 1 FROM app_erp_mes_core.emc_job_order r\n  WHERE r.equipment_id = o.equipment_id AND r.dispatch_status = 'RUNNING' AND r.job_no <> o.job_no\n)\nUNION ALL\nSELECT o.job_no, COALESCE(o.equipment_id,'') AS equipment_id, o.dispatch_status,\n       'CAPABILITY_WINDOW' AS conflict_kind,\n       'No AVAILABLE operations capability window for equipment' AS detail\nFROM app_erp_mes_core.emc_job_order o\nWHERE o.dispatch_status IN ('ALLOWED','NOT_ALLOWED')\nAND o.equipment_id IS NOT NULL\nAND NOT EXISTS (\n  SELECT 1 FROM app_erp_mes_core.emc_operations_capability c\n  JOIN app_erp_mes_core.emc_ops_capability_equipment ce ON ce.capability_id = c.capability_id\n  WHERE ce.equipment_id = o.equipment_id AND c.status = 'AVAILABLE'\n  AND (c.available_from IS NULL OR c.available_from <= CURRENT_TIMESTAMP)\n  AND (c.available_to IS NULL OR c.available_to >= CURRENT_TIMESTAMP)\n)\nORDER BY job_no\n",
      "columns": [
        {
          "field": "job_no",
          "label": "Job #"
        },
        {
          "field": "equipment_id",
          "label": "Equipment"
        },
        {
          "field": "dispatch_status",
          "label": "Status"
        },
        {
          "field": "conflict_kind",
          "label": "Kind"
        },
        {
          "field": "detail",
          "label": "Detail"
        }
      ]
    },
    {
      "reportId": "aps-freezes",
      "title": "Plan freezes",
      "description": "Frozen equipment windows.",
      "query": "\nSELECT freeze_id, COALESCE(equipment_id,'') AS equipment_id, frozen_at, COALESCE(note,'') AS note\nFROM aps_plan_freeze ORDER BY frozen_at DESC\n",
      "columns": [
        {
          "field": "freeze_id",
          "label": "Freeze"
        },
        {
          "field": "equipment_id",
          "label": "Equipment"
        },
        {
          "field": "frozen_at",
          "label": "Frozen at"
        },
        {
          "field": "note",
          "label": "Note"
        }
      ]
    }

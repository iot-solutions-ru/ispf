# Opt-in single-engine MSSQL. Not Prod Yes. Unbounded 10y/20s scans stay non-claims.
# Dedicated instance, RCSI ON, case-sensitive collation — DBA steps, not this file.

ISPF_METADATA_DB_KIND=mssql
ISPF_MSSQL_SINGLE_ENGINE=true
ISPF_HISTORIAN_DEPLOY_PROFILE=mssql-single-engine
ISPF_HISTORIAN_TIER_WARM_ENABLED=false
ISPF_HISTORIAN_COLD_ARCHIVE_ENABLED=false
ISPF_VARIABLE_HISTORY_ENABLED=true
ISPF_VARIABLE_HISTORY_STORE=jdbc
ISPF_VARIABLE_HISTORY_DUAL_WRITE_ENABLED=false
ISPF_VARIABLE_HISTORY_SPOOL_ENABLED=false
ISPF_MSSQL_JDBC_BUFFER=false
# Gate C2 JDBC rollup writer (sampled_at 1h/1d). Default off. Not SWITCH; charts still raw observed_at.
ISPF_MSSQL_ROLLUP_MATERIALIZER=false
ISPF_EVENT_JOURNAL_ENABLED=true
ISPF_EVENT_JOURNAL_STORE=jdbc
ISPF_TENANT_DB_ROW_ISOLATION=false
ISPF_CLUSTER_ENABLED=false

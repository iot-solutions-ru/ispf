{
  "name": "@ispf/web-console",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/copy-legal-assets.mjs && node node_modules/@typescript/native/bin/tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:preview": "playwright test --config playwright.preview.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "test:quality": "playwright test --config playwright.quality.config.ts",
    "bundle:budget": "node scripts/bundle-budget.mjs",
    "lighthouse:ci": "node scripts/lighthouse-ci.mjs",
    "quality:gates": "npm run build && npm run bundle:budget && npm run lighthouse:ci && npm run test:quality",
    "pwa:offline-evidence": "node scripts/pwa-offline-evidence.mjs",
    "pwa:offline-field-soak": "node scripts/pwa-offline-field-soak.mjs",
    "i18n:check": "node scripts/i18n-check-keys.mjs && node scripts/i18n-check-hardcoded.mjs",
    "i18n:translate": "python ../../tools/i18n/generate-locales.py",
    "import:pid-symbols": "npm run build --prefix ../../tools/symbol-pack-isa",
    "build:pid-symbols": "npm run build --prefix ../../tools/symbol-pack-isa"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@codemirror/lang-java": "^6.0.2",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-virtual": "^3.14.13",
    "@uiw/codemirror-theme-vscode": "^4.25.10",
    "@uiw/react-codemirror": "^4.25.10",
    "antd": "^6.6.4",
    "bpmn-auto-layout": "^1.3.0",
    "bpmn-moddle": "^10.2.0",
    "cytoscape": "^3.34.3",
    "dompurify": "^3.4.15",
    "exceljs": "^4.4.0",
    "framer-motion": "^13.4.0",
    "i18next": "^26.4.2",
    "maplibre-gl": "^6.4.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.14",
    "react-map-gl": "^8.1.3",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "chrome-launcher": "^1.1.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "lighthouse": "^13.5.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "fast-uri": "3.1.6",
    "browserslist": "4.28.7",
    "baseline-browser-mapping": "2.11.0",
    "uuid": "11.1.1",
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.4",
    "brace-expansion@5": "5.0.12"
  }
}

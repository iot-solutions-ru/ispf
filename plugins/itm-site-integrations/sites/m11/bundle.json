{
  "version": "1.1.2",
  "displayName": "ITM integrations — Трасса М11",
  "tablePrefix": "",
  "schemaName": "it_infra_monitoring",
  "metadata": {
    "packageId": "itm-plugin-integrations-m11",
    "siteId": "m11",
    "dependsOnApp": "it-infra-monitoring",
    "ldap": {
      "enabled": true,
      "driverId": "ldap",
      "url": "ldap://ad.m11.local:389",
      "baseDn": "DC=m11,DC=local",
      "bindDn": "CN=ispf-svc,OU=Service,DC=m11,DC=local",
      "roleMap": {
        "CN=ISPF-Admin,OU=Groups,DC=m11,DC=local": "admin",
        "CN=ISPF-AdmSpd,OU=Groups,DC=m11,DC=local": "admSpd",
        "CN=ISPF-AdmSrv,OU=Groups,DC=m11,DC=local": "admSrv",
        "CN=ISPF-AdmIt,OU=Groups,DC=m11,DC=local": "admIt",
        "CN=ISPF-Director,OU=Groups,DC=m11,DC=local": "director"
      }
    },
    "roles": [
      "admin",
      "admSpd",
      "admSrv",
      "admIt",
      "director",
      "noc",
      "operator",
      "viewer"
    ],
    "opcUa": {
      "enabled": true,
      "driverId": "opcua",
      "endpointUrl": "opc.tcp://cms-m11.local:4840",
      "mode": "native-ua-or-da-ua-gateway",
      "devicePath": "root.platform.devices.itm.cms-opcua",
      "tags": [
        "ns=2;s=M11.SPD.Alarm.*",
        "ns=2;s=M11.SPD.Warn.*",
        "ns=2;s=M11.SRV.Warn.*"
      ]
    }
  },
  "events": [
    {
      "id": "itmAdAuthFailure",
      "roles": [
        "admin",
        "noc"
      ]
    },
    {
      "id": "itmCmsBridgeDown",
      "roles": [
        "admin",
        "noc"
      ]
    }
  ],
  "migrations": [
    {
      "id": "itm_integrations_m11_note",
      "sql": "CREATE TABLE IF NOT EXISTS itm_integrations_m11_meta (site_id VARCHAR(64) PRIMARY KEY, note VARCHAR(256)); INSERT INTO itm_integrations_m11_meta (site_id, note) SELECT 'm11', 'LDAP + OPC UA (cms-opcua DEVICE) — configure drivers post-deploy' WHERE NOT EXISTS (SELECT 1 FROM itm_integrations_m11_meta WHERE site_id = 'm11');"
    }
  ]
}
